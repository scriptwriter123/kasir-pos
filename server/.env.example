# Konfigurasi server billing/aktivasi POS. Salin ke server\.env
APP_NAME="POS Billing"
APP_ENV=development
DATABASE_URL=sqlite:///server/data/billing.db
BASE_URL=http://localhost:8001

# Private key Ed25519 untuk menandatangani lisensi.
# JANGAN commit file .env atau private key ke repository.
LICENSE_PRIVATE_KEY_PATH=
LICENSE_PRIVATE_KEY_PASSPHRASE=

# Midtrans (sandbox secara default; lihat MIDTRANS_API_URL)
MIDTRANS_SERVER_KEY=
MIDTRANS_API_URL=https://api.sandbox.midtrans.com/v2
MIDTRANS_SNAP_API_URL=https://api.sandbox.midtrans.com/snap/v1
# Client key untuk Snap.js di frontend. Ambil dari dashboard Midtrans:
# Settings → Access Keys → Client Key (awalan SB-Mid-client-).
MIDTRANS_SNAP_CLIENT_KEY=

# Kunci endpoint admin (penerbitan manual saat pengujian)
ADMIN_API_KEY=

# Akun admin dashboard webserver (/admin). Dibuat otomatis saat startup
# dan bisa dibuat manual via: python -m server.seed_admin
# GANTI password ini di produksi.
ADMIN_EMAIL="admin@pos.local"
ADMIN_PASSWORD="admin12345"

# File instalator POS yang disediakan untuk diunduh di halaman web
INSTALLER_PATH=build/installer_v3/AnjayRetailSoft.exe
