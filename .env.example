APP_NAME=POSApp
APP_ENV=development
APP_DEBUG=true
SESSION_TIMEOUT_MINUTES=480

# Gerbang pembayaran untuk metode bayar di kasir (QRIS/DLL).
# JANGAN diisi lewat .env — owner menentukan gerbangnya sendiri melalui
# menu Pengaturan Toko (Payment Wizard). Nilai disimpan di database,
# bukan di file ini. Kosongkan agar kredensial merchant tidak bocor ke
# berkas konfigurasi.
MIDTRANS_SERVER_KEY=

# Opsional: URL HTTPS publik endpoint /api/webhooks/midtrans.
# Diisi otomatis oleh Payment Wizard bila owner mengaktifkan notifikasi.
MIDTRANS_NOTIFICATION_URL=

# Alamat webserver billing/aktivasi untuk aktivasi otomatis POS.
# Untuk akses dari luar jaringan lokal: pakai scripts\start_ngrok.ps1
# (menulis URL publik ngrok ke baris ini secara otomatis).
# Kosongkan untuk menonaktifkan aktivasi online (hanya impor .poslic manual).
billing_server_url=http://127.0.0.1:8001

# Durasi trial dalam MENIT (hanya untuk pengembangan/uji coba).
# Production (deployment di server baru): hapus baris ini agar trial 7 hari.
trial_minutes=2
